#!/usr/bin/env bash

set -euo pipefail

SCRIPT_ROOT=$(cd "$(dirname "$0")/.." && pwd)

# Load only tool-selection functions; never run the merge wizard.
eval "$(sed -n '/^select_mergetool()/,/^# Pending merge file/p' "$SCRIPT_ROOT/bin/merge" | sed '$d')"

print_error() { printf '%s\n' "$*" >&2; }
uname() { printf '%s\n' "$TEST_OS"; }
git() { printf '%s' "$TEST_CONFIG"; }
mergetool_is_available() { [[ " $TEST_AVAILABLE " == *" $1 "* ]]; }

check_selection()
{
    local expected="$1"
    select_mergetool
    if [ "$MERGE_TOOL" != "$expected" ]; then
        printf 'Expected %s, got %s\n' "$expected" "$MERGE_TOOL" >&2
        exit 1
    fi
}

TEST_OS=Haiku
TEST_CONFIG=meld
TEST_AVAILABLE='kdiff3 vimdiff nvimdiff'
SSH_CONNECTION=''
SSH_TTY=''
MERGE_TOOL=''
check_selection kdiff3

MERGE_TOOL=''
SSH_CONNECTION='test connection'
check_selection vimdiff

MERGE_TOOL=''
TEST_AVAILABLE='kdiff3 nvimdiff'
check_selection nvimdiff

MERGE_TOOL=''
TEST_AVAILABLE=kdiff3
check_selection '(none available)'

# Valid Git configuration and explicit overrides retain priority.
MERGE_TOOL=''
TEST_CONFIG=custom
TEST_AVAILABLE=custom
check_selection custom

MERGE_TOOL=explicit
check_selection explicit

MERGE_TOOL=''
TEST_CONFIG=''
TEST_OS=Linux
TEST_AVAILABLE='meld kdiff3 vimdiff'
check_selection meld

# Exercise Git's real validation and invocation mapping with only KDiff3 present.
unset -f git mergetool_is_available
eval "$(sed -n '/^merge_tool_git()/,/^select_mergetool()/p' "$SCRIPT_ROOT/bin/merge" | sed '$d')"
TEST_OS=Haiku
WORK=$(mktemp -d)
trap 'rm -f "$WORK/KDiff3"; rmdir "$WORK"' EXIT
printf '#!/usr/bin/env bash\nexit 0\n' > "$WORK/KDiff3"
chmod +x "$WORK/KDiff3"
(
    cd "$WORK"
    export PATH="$WORK:$PATH"
    export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
    test "$(merge_tool_git config --get mergetool.kdiff3.path)" -ef "$WORK/KDiff3"
    mergetool_is_available kdiff3
    test "$(merge_tool_git -c mergetool.kdiff3.path=explicit-path config --get mergetool.kdiff3.path)" = explicit-path
)

printf 'Merge tool selection tests passed.\n'
