#!/usr/bin/env bash

logicalCpuCount=$(nproc --all)

build_parallelization=$((logicalCpuCount - 1))

if [ "$build_parallelization" -lt 1 ]; then
    build_parallelization=1
fi

echo "Build Parallelization $build_parallelization"

echo "ninja -j $build_parallelization $@"

exec ninja -j "$build_parallelization" "$@"
