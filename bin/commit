#!/usr/bin/env bash

set -u


#
# ----------------------------------------------------------------------
# Top-level recursion guard
#
# Prevent commit from launching another commit process.
# ----------------------------------------------------------------------
#

if [ "${CA2_COMMIT_RUNNING:-0}" = "1" ]; then

    echo "ERROR: Recursive invocation of commit detected." >&2
    echo "commit must not invoke commit, checkout, or another operation" >&2
    echo "that eventually invokes commit again." >&2

    exit 1

fi

export CA2_COMMIT_RUNNING=1


#
# ----------------------------------------------------------------------
# Per-phase visited repository lists
#
# These prevent recursive/cyclic submodule graphs from causing an
# infinite loop inside the same Bash process.
#
# Each phase needs its own list because a repository legitimately needs
# to be visited once in each phase.
# ----------------------------------------------------------------------
#

COMMIT_VISITED=""
PREFLIGHT_VISITED=""
PUSH_VISITED=""


DEDICATORY_FILE="$HOME/dedicatory.txt"
PENDING_MERGES_FILE="commit_pending_merges.txt"


#
# ca2 and cpp-port repositories are writable repositories.
#

OWNED_REMOTE_REGEX='github\.com[:/](ca2|cpp-port)/'


ERROR_COLOR=""
SUCCESS_COLOR=""
ERROR_RESET=""
SUCCESS_RESET=""


if [ -z "${NO_COLOR+x}" ] &&
   [ "${TERM:-}" != "dumb" ]; then

    if [ -t 2 ]; then

        ERROR_COLOR=$'\033[1;31m'
        ERROR_RESET=$'\033[0m'

    fi


    if [ -t 1 ]; then

        SUCCESS_COLOR=$'\033[1;34m'
        SUCCESS_RESET=$'\033[0m'

    fi

fi


print_error()
{

    printf '%s%s%s\n' \
        "$ERROR_COLOR" \
        "$*" \
        "$ERROR_RESET" >&2

}


print_success()
{

    printf '%s%s%s\n' \
        "$SUCCESS_COLOR" \
        "$*" \
        "$SUCCESS_RESET"

}


pushd()
{

    command pushd "$@" > /dev/null

}


popd()
{

    command popd "$@" > /dev/null

}


#
# Track canonical repository roots separately for each recursive phase.
# An indexed array also works on Bash versions without associative arrays.
#

VISITED_REPOSITORIES=()


get_exact_repository_root()
{
    local directory="$1"
    local requested_root
    local git_root


    requested_root=$(
        cd "$directory" 2>/dev/null && pwd -P
    ) || {

        print_error "ERROR: Cannot access repository directory: $directory"

        return 1
    }


    git_root=$(git -C "$requested_root" rev-parse \
        --show-toplevel 2>/dev/null || true)

    if [ -z "$git_root" ]; then

        print_error "ERROR: Not a Git repository: $requested_root"

        return 1

    fi


    git_root=$(
        cd "$git_root" 2>/dev/null && pwd -P
    ) || {

        print_error "ERROR: Cannot resolve Git repository root: $requested_root"

        return 1
    }


    #
    # Git searches parent directories when a submodule is uninitialized.
    # Being inside a work tree does not prove this is its own repository.
    #

    if [ "$requested_root" != "$git_root" ]; then

        print_error "ERROR: Expected an independent Git repository."
        printf '   Requested path : %s\n' "$requested_root" >&2
        printf '   Git root       : %s\n' "$git_root" >&2
        print_error "The submodule may be missing or not initialized correctly."

        return 1

    fi


    printf '%s\n' "$git_root"
}


mark_repository_visited()
{
    local phase="$1"
    local git_root="$2"
    local visit_key="${phase}:${git_root}"
    local visited_key


    for visited_key in "${VISITED_REPOSITORIES[@]-}"; do

        if [ "$visited_key" = "$visit_key" ]; then

            print_error "ERROR: Recursive repository cycle detected."
            printf '   Phase      : %s\n' "$phase" >&2
            printf '   Repository : %s\n' "$git_root" >&2

            return 1

        fi

    done


    VISITED_REPOSITORIES+=("$visit_key")

    return 0
}


is_owned_remote()
{

    local url="$1"

    [[ "$url" =~ $OWNED_REMOTE_REGEX ]]

}


#
# Return the physical canonical top-level directory of a repository.
#
# pwd -P resolves symbolic links, which helps detect cases where the
# same repository is reached through two different filesystem paths.
#

canonical_repository_root()
{

    local directory="$1"
    local root


    root=$(git -C "$directory" \
        rev-parse \
        --show-toplevel \
        2>/dev/null) || return 1


    (
        cd "$root" || exit 1
        pwd -P
    )

}


#
# Check whether a canonical repository path is already present in
# a newline-separated visited list.
#

repository_was_visited()
{

    local visited="$1"
    local repository="$2"


    if [ -z "$visited" ]; then

        return 1

    fi


    printf '%s\n' "$visited" |
        grep -Fqx -- "$repository"

}


get_submodule_remote_url()
{

    local submodule_name="$1"
    local submodule_path="$2"
    local url


    #
    # git submodule init/sync resolves relative .gitmodules URLs
    # against the parent's origin and stores the usable URL here.
    #
    # Prefer that resolved value for ownership decisions.
    #

    url=$(git config \
        --get "submodule.${submodule_name}.url" \
        2>/dev/null || true)


    if [ -z "$url" ] &&
       git -C "$submodule_path" rev-parse \
        --is-inside-work-tree \
        >/dev/null 2>&1; then

        url=$(git -C "$submodule_path" remote get-url \
            origin \
            2>/dev/null || true)

    fi


    if [ -z "$url" ]; then

        url=$(git config \
            --file .gitmodules \
            --get "submodule.${submodule_name}.url" \
            2>/dev/null || true)

    fi


    printf '%s\n' "$url"

}


get_branch()
{

    local configured_branch="${1:-}"
    local branch


    #
    # Prefer branch explicitly configured by the parent.
    #

    if [ -n "$configured_branch" ] &&
       [ "$configured_branch" != "." ]; then

        printf '%s\n' "$configured_branch"

        return 0

    fi


    #
    # Current branch.
    #

    branch=$(git symbolic-ref \
        --quiet \
        --short HEAD \
        2>/dev/null || true)


    if [ -n "$branch" ]; then

        printf '%s\n' "$branch"

        return 0

    fi


    #
    # Detached submodule:
    # use origin default branch if available.
    #

    branch=$(git symbolic-ref \
        --quiet \
        --short refs/remotes/origin/HEAD \
        2>/dev/null || true)


    if [ -n "$branch" ]; then

        printf '%s\n' "${branch#origin/}"

        return 0

    fi


    #
    # ca2 default.
    #

    printf '%s\n' "main"

}


commit_is_available_from_origin()
{

    local directory="$1"
    local commit="$2"
    local remote_tags


    #
    # Refresh every advertised branch.
    #
    # A commit reachable from one of these refs is reproducible
    # by a fresh clone.
    #

    if ! git -C "$directory" fetch \
        --prune \
        origin \
        '+refs/heads/*:refs/remotes/origin/*'; then

        return 1

    fi


    if git -C "$directory" for-each-ref \
        --format='%(refname)' \
        --contains="$commit" \
        refs/remotes/origin |
        grep -q .; then

        return 0

    fi


    #
    # Also accept commits directly advertised by lightweight
    # or annotated tags.
    #

    remote_tags=$(git -C "$directory" ls-remote \
        --tags \
        origin \
        2>/dev/null || true)


    if printf '%s\n' "$remote_tags" |
        awk '{print $1}' |
        grep -Fqx -- "$commit"; then

        return 0

    fi


    return 1

}


verify_external_submodule_commit()
{

    local submodule_path="$1"
    local submodule_url="$2"
    local commit


    commit=$(git -C "$submodule_path" rev-parse HEAD)


    echo
    echo "Verifying external submodule commit is published:"
    echo "   $submodule_path"
    echo "   $commit"


    if commit_is_available_from_origin \
        "$submodule_path" \
        "$commit"; then

        return 0

    fi


    echo
    print_error \
        "ERROR: External submodule commit is not reachable from"

    echo "any branch or tag advertised by its origin:"
    echo
    echo "   Path   : $submodule_path"
    echo "   URL    : $submodule_url"
    echo "   Commit : $commit"
    echo
    echo "Refusing to record this unreproducible gitlink."


    return 1

}


verify_published_head()
{

    local branch="$1"
    local local_commit
    local remote_commit


    local_commit=$(git rev-parse HEAD)


    remote_commit=$(git ls-remote \
        --heads \
        origin \
        "refs/heads/$branch" |
        awk 'NR == 1 { print $1 }')


    if [ "$remote_commit" = "$local_commit" ]; then

        return 0

    fi


    echo
    print_error \
        "ERROR: Push returned without publishing the exact local HEAD."

    echo
    echo "   Branch        : $branch"
    echo "   Local HEAD    : $local_commit"
    echo "   Remote branch : ${remote_commit:-<missing>}"


    return 1

}


#
# ======================================================================
# PHASE 1
#
# Commit local work recursively, bottom-to-top.
#
# NO CHECKOUT.
# NO MERGE.
# NO PUSH.
# ======================================================================
#

commit_repository()
{

    local directory="$1"

    local git_root
    local canonical_root
    local key
    local submodule_path
    local submodule_name
    local submodule_url


    pushd "$directory" || return 1


    git_root=$(get_exact_repository_root ".") || {

        popd

        return 1

    }


    if ! mark_repository_visited "commit" "$git_root"; then

        popd

        return 1

    fi


    cd "$git_root" || {

        popd

        return 1

    }


    canonical_root=$(canonical_repository_root "$git_root") || {

        popd

        return 1

    }


    #
    # Prevent recursive/cyclic repository traversal.
    #

    if repository_was_visited \
        "$COMMIT_VISITED" \
        "$canonical_root"; then

        echo
        echo "Already visited during commit phase:"
        echo "   $canonical_root"
        echo "Skipping to prevent recursive repository cycle."

        popd

        return 0

    fi


    if [ -z "$COMMIT_VISITED" ]; then

        COMMIT_VISITED="$canonical_root"

    else

        COMMIT_VISITED="${COMMIT_VISITED}"$'\n'"${canonical_root}"

    fi


    echo
    echo "============================================================"
    echo "Committing repository:"
    echo "   $git_root"
    echo "============================================================"


    #
    # CHILDREN FIRST.
    #

    if [ -f .gitmodules ]; then

        while IFS=' ' read -r key submodule_path; do

            if [ -z "${key:-}" ] ||
               [ -z "${submodule_path:-}" ]; then

                continue

            fi


            submodule_name="${key#submodule.}"
            submodule_name="${submodule_name%.path}"


            submodule_url=$(get_submodule_remote_url \
                "$submodule_name" \
                "$submodule_path")


            if [ ! -d "$submodule_path" ]; then

                continue

            fi


            if ! get_exact_repository_root \
                "$submodule_path" >/dev/null; then

                popd

                return 1

            fi


            if is_owned_remote "$submodule_url"; then

                echo
                echo "Descending into owned submodule:"
                echo "   $submodule_path"


                if ! commit_repository \
                    "$submodule_path"; then

                    popd

                    return 1

                fi

            else

                echo
                echo "External submodule:"
                echo "   $submodule_path"
                echo "Not committing inside it."


                if ! verify_external_submodule_commit \
                    "$submodule_path" \
                    "$submodule_url"; then

                    popd

                    return 1

                fi

            fi


        done < <(
            git config \
                --file .gitmodules \
                --get-regexp '^submodule\..*\.path$' \
                2>/dev/null || true
        )

    fi


    #
    # Stage repository after children are finished.
    #

    if ! git add -A -- .; then

        popd

        return 1

    fi


    if git diff --cached --quiet; then

        echo "No local changes to commit."

    else

        if [ ! -f "$DEDICATORY_FILE" ]; then

            echo
            print_error "ERROR: Commit message file does not exist:"
            echo "   $DEDICATORY_FILE"

            popd

            return 1

        fi


        echo
        echo "Committing local changes."


        if ! git commit \
            -F "$DEDICATORY_FILE"; then

            echo
            print_error "ERROR: Commit failed:"
            echo "   $git_root"

            popd

            return 1

        fi

    fi


    popd

    return 0

}


#
# ======================================================================
# PHASE 2
#
# Detect repositories requiring remote history to be merged.
#
# This phase does NOT checkout, merge, rebase, reset, or push.
# ======================================================================
#

append_pending_merge()
{

    local relative_path="$1"


    if [ -z "$relative_path" ]; then

        return

    fi


    if ! grep -Fqx \
        -- "$relative_path" \
        "$ROOT_PENDING_FILE" \
        2>/dev/null; then

        printf '%s\n' \
            "$relative_path" \
            >> "$ROOT_PENDING_FILE"

    fi

}


repository_requires_merge()
{

    local configured_branch="${1:-}"

    local branch
    local remote_ref


    branch=$(get_branch "$configured_branch")

    remote_ref="refs/remotes/origin/$branch"


    echo "Fetching origin/$branch..."


    if ! git fetch \
        origin \
        "$branch"; then

        echo
        print_error \
            "WARNING: Could not fetch origin/$branch."

        return 2

    fi


    if ! git show-ref \
        --verify \
        --quiet \
        "$remote_ref"; then

        return 1

    fi


    #
    # Remote already contained in local HEAD:
    #
    #   equal
    #   or local ahead
    #

    if git merge-base \
        --is-ancestor \
        "$remote_ref" \
        HEAD; then

        return 1

    fi


    #
    # Remote contains commits local HEAD does not contain.
    #
    # This means local is behind or histories diverged.
    #

    return 0

}


preflight_repository()
{

    local directory="$1"
    local root_relative_path="$2"
    local configured_branch="${3:-}"

    local git_root
    local canonical_root
    local current_remote

    local key
    local submodule_path
    local submodule_name
    local submodule_url
    local submodule_branch
    local child_relative_path
    local merge_status


    pushd "$directory" || return 1


    git_root=$(get_exact_repository_root ".") || {

        popd

        return 1

    }


    if ! mark_repository_visited "preflight" "$git_root"; then

        popd

        return 1

    fi


    cd "$git_root" || {

        popd

        return 1

    }


    canonical_root=$(canonical_repository_root "$git_root") || {

        popd

        return 1

    }


    #
    # Prevent recursive/cyclic repository traversal.
    #

    if repository_was_visited \
        "$PREFLIGHT_VISITED" \
        "$canonical_root"; then

        echo
        echo "Already visited during preflight phase:"
        echo "   $canonical_root"
        echo "Skipping duplicate/cyclic repository."

        popd

        return 0

    fi


    if [ -z "$PREFLIGHT_VISITED" ]; then

        PREFLIGHT_VISITED="$canonical_root"

    else

        PREFLIGHT_VISITED="${PREFLIGHT_VISITED}"$'\n'"${canonical_root}"

    fi


    echo
    echo "Preflight:"
    echo "   $git_root"


    current_remote=$(git remote get-url \
        origin \
        2>/dev/null || true)


    if is_owned_remote "$current_remote"; then

        repository_requires_merge \
            "$configured_branch"

        merge_status=$?


        if [ "$merge_status" -eq 0 ]; then

            if [ -n "$root_relative_path" ]; then

                echo "PENDING MERGE:"
                echo "   $root_relative_path"

                append_pending_merge \
                    "$root_relative_path"

            else

                #
                # Root repository represented by ".".
                #

                echo "PENDING MERGE:"
                echo "   ."

                append_pending_merge "."

            fi

        elif [ "$merge_status" -eq 2 ]; then

            echo
            print_error \
                "ERROR: Preflight could not verify the remote branch."

            popd

            return 1

        fi

    fi


    #
    # Recurse through owned submodules.
    #

    if [ -f .gitmodules ]; then

        while IFS=' ' read -r key submodule_path; do

            if [ -z "${key:-}" ] ||
               [ -z "${submodule_path:-}" ]; then

                continue

            fi


            submodule_name="${key#submodule.}"
            submodule_name="${submodule_name%.path}"


            submodule_url=$(get_submodule_remote_url \
                "$submodule_name" \
                "$submodule_path")


            submodule_branch=$(git config \
                --file .gitmodules \
                --get "submodule.${submodule_name}.branch" \
                2>/dev/null || true)


            if ! is_owned_remote "$submodule_url"; then

                continue

            fi


            if [ ! -d "$submodule_path" ]; then

                continue

            fi


            if ! git -C "$submodule_path" \
                rev-parse \
                --is-inside-work-tree \
                >/dev/null 2>&1; then

                continue

            fi


            if [ -z "$root_relative_path" ] ||
               [ "$root_relative_path" = "." ]; then

                child_relative_path="$submodule_path"

            else

                child_relative_path="$root_relative_path/$submodule_path"

            fi


            if ! preflight_repository \
                "$submodule_path" \
                "$child_relative_path" \
                "$submodule_branch"; then

                popd

                return 1

            fi


        done < <(
            git config \
                --file .gitmodules \
                --get-regexp '^submodule\..*\.path$' \
                2>/dev/null || true
        )

    fi


    popd

    return 0

}


#
# ======================================================================
# PHASE 3
#
# Push recursively, bottom-to-top.
#
# Only executed when there are no pending merges.
# ======================================================================
#

push_repository()
{

    local directory="$1"
    local configured_branch="${2:-}"

    local git_root
    local canonical_root
    local branch

    local key
    local submodule_path
    local submodule_name
    local submodule_url
    local submodule_branch


    pushd "$directory" || return 1


    git_root=$(get_exact_repository_root ".") || {

        popd

        return 1

    }


    if ! mark_repository_visited "push" "$git_root"; then

        popd

        return 1

    fi


    cd "$git_root" || {

        popd

        return 1

    }


    canonical_root=$(canonical_repository_root "$git_root") || {

        popd

        return 1

    }


    #
    # Prevent recursive/cyclic repository traversal.
    #

    if repository_was_visited \
        "$PUSH_VISITED" \
        "$canonical_root"; then

        echo
        echo "Already visited during push phase:"
        echo "   $canonical_root"
        echo "Skipping duplicate/cyclic repository."

        popd

        return 0

    fi


    if [ -z "$PUSH_VISITED" ]; then

        PUSH_VISITED="$canonical_root"

    else

        PUSH_VISITED="${PUSH_VISITED}"$'\n'"${canonical_root}"

    fi


    #
    # CHILDREN FIRST.
    #

    if [ -f .gitmodules ]; then

        while IFS=' ' read -r key submodule_path; do

            if [ -z "${key:-}" ] ||
               [ -z "${submodule_path:-}" ]; then

                continue

            fi


            submodule_name="${key#submodule.}"
            submodule_name="${submodule_name%.path}"


            submodule_url=$(get_submodule_remote_url \
                "$submodule_name" \
                "$submodule_path")


            submodule_branch=$(git config \
                --file .gitmodules \
                --get "submodule.${submodule_name}.branch" \
                2>/dev/null || true)


            if ! is_owned_remote "$submodule_url"; then

                continue

            fi


            if [ ! -d "$submodule_path" ]; then

                continue

            fi


            if ! git -C "$submodule_path" \
                rev-parse \
                --is-inside-work-tree \
                >/dev/null 2>&1; then

                continue

            fi


            if ! push_repository \
                "$submodule_path" \
                "$submodule_branch"; then

                popd

                return 1

            fi


        done < <(
            git config \
                --file .gitmodules \
                --get-regexp '^submodule\..*\.path$' \
                2>/dev/null || true
        )

    fi


    branch=$(get_branch "$configured_branch")


    echo
    echo "Pushing:"
    echo "   $git_root"
    echo "to:"
    echo "   origin/$branch"


    if ! git push \
        --recurse-submodules=check \
        origin \
        "HEAD:$branch"; then

        echo
        print_error "ERROR: Push failed:"
        echo "   $git_root"

        popd

        return 1

    fi


    if ! verify_published_head \
        "$branch"; then

        popd

        return 1

    fi


    popd

    return 0

}


#
# ======================================================================
# Main
# ======================================================================
#

if [ $# -ge 1 ]; then

    BASEDIR="$1"

else

    BASEDIR=$(git rev-parse \
        --show-toplevel \
        2>/dev/null || true)

fi


if [ -z "${BASEDIR:-}" ]; then

    print_error \
        "ERROR: Current directory is not inside a Git repository."

    exit 1

fi


pushd "$BASEDIR" || exit 1


BASEDIR=$(git rev-parse \
    --show-toplevel \
    2>/dev/null || true)


popd


if [ -z "$BASEDIR" ]; then

    print_error \
        "ERROR: Specified directory is not inside a Git repository."

    exit 1

fi


ROOT_PENDING_FILE="$BASEDIR/$PENDING_MERGES_FILE"


#
# Remove old operational merge list before staging anything.
#

rm -f "$ROOT_PENDING_FILE"


echo
echo "============================================================"
echo "PHASE 1: Committing local changes recursively"
echo "============================================================"


if ! commit_repository \
    "$BASEDIR"; then

    echo
    print_error \
        "ERROR: Recursive commit phase failed."

    exit 1

fi


echo
echo "============================================================"
echo "PHASE 2: Checking for pending remote merges"
echo "============================================================"


#
# Start fresh.
#

: > "$ROOT_PENDING_FILE"


if ! preflight_repository \
    "$BASEDIR" \
    "" \
    ""; then

    echo
    print_error \
        "ERROR: Recursive preflight failed. Nothing was pushed."

    exit 1

fi


if [ -s "$ROOT_PENDING_FILE" ]; then

    echo
    echo "============================================================"
    echo "Local changes have been committed successfully."
    echo
    echo "Push postponed because these repositories need merging:"
    echo

    cat "$ROOT_PENDING_FILE"

    echo
    echo "Pending merge list:"
    echo "   $ROOT_PENDING_FILE"
    echo
    echo "Run the merge wizard, then run commit again."
    echo "============================================================"


    #
    # IMPORTANT:
    #
    # Do NOT invoke:
    #
    #   checkout
    #   merge
    #   commit
    #
    # from here.
    #
    # Exit 2 means local commits succeeded, but remote history
    # requires integration before pushing.
    #

    exit 2

fi


#
# No pending merges.
#

rm -f "$ROOT_PENDING_FILE"


echo
echo "============================================================"
echo "PHASE 3: No pending merges. Pushing recursively."
echo "============================================================"


if ! push_repository \
    "$BASEDIR" \
    ""; then

    echo
    print_error \
        "ERROR: Recursive push phase failed."

    exit 1

fi


echo
print_success \
    "============================================================"

print_success \
    "Recursive commit and push completed successfully."

print_success \
    "============================================================"


exit 0
